# Copy this file to .env.local (local dev) or set these in Vercel → Settings → Environment Variables.
# NEVER prefix a secret with VITE_: Vite inlines VITE_* variables into the public browser bundle.

# ── Server-only secrets ──────────────────────────────────────────────────────
# Anthropic API key (https://console.anthropic.com/). Used only by /api/claude.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Supabase project URL and anon (public) key. The server uses them to verify the signed-in
# user's token before any AI call; without them, /api/claude refuses every request.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase SERVICE ROLE key (Supabase dashboard -> Project Settings -> API). Bypasses every
# row-level security policy, so it is the most sensitive secret in this project: server-only, never
# VITE_, never committed. The farm-records agent uses it for exactly one thing: saving the records
# it captures (everything else runs as the signed-in user). Without it, /api/agent/capture cannot save.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram bot (see docs/TELEGRAM_SETUP.md). Server-only secrets: never VITE_.
# TELEGRAM_BOT_TOKEN=123456:your-token-from-botfather
# TELEGRAM_WEBHOOK_SECRET=a-long-random-string     # openssl rand -hex 24

# ── Browser-visible (public by design) ───────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_TELEGRAM_BOT_USERNAME=MyFarmRecordsBot     # the bot's public username

# CAPTCHA on sign-in / sign-up. Only needed if "Enable CAPTCHA protection" is ON in Supabase (Authentication →
# Attack Protection). Both values are PUBLIC; the provider's SECRET key goes in the Supabase dashboard only.
# VITE_CAPTCHA_PROVIDER=turnstile                   # turnstile | hcaptcha
# VITE_CAPTCHA_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx    # the provider's public SITE key

# ── Optional tuning for /api/claude (defaults shown) ─────────────────────────
# ANTHROPIC_MODEL=claude-sonnet-4-6
# AI_MAX_OUTPUT_TOKENS=2048        # hard ceiling 16000
# AI_RATE_LIMIT_PER_MIN=20         # per user (shared across instances once migration 8 is applied and the service key is set)
# AI_RATE_LIMIT_PER_DAY=400        # per user
# AI_RATE_LIMIT_GLOBAL_PER_DAY=5000   # everyone combined: a ceiling on spend
# AI_MAX_INPUT_CHARS=200000        # text characters per request
# AI_MAX_ATTACHMENTS=4
# ALLOWED_ORIGINS=                 # comma-separated; leave empty for same-origin only

# ── Optional tuning for the farm-records agent /api/agent/* (defaults shown) ─
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium              # low | medium | high | xhigh | max
# AGENT_MAX_TOKENS=4096            # hard ceiling 16000
# AGENT_STRICT_TOOLS=false         # true is rejected by the API for the 9 record tools (too many nullable fields)
# AGENT_REQUEST_TIMEOUT_MS=90000
# AGENT_MAX_TEXT_CHARS=8000
# AGENT_MAX_ATTACHMENTS=3
# AGENT_MAX_ATTACHMENT_CHARS=3500000        # per file, base64 characters (Vercel caps bodies near 4.5 MB)
# AGENT_MAX_TOTAL_ATTACHMENT_CHARS=4000000  # all files in one request
# AGENT_RATE_LIMIT_PER_MIN=6       # per user
# AGENT_RATE_LIMIT_PER_DAY=100
# AGENT_RATE_LIMIT_GLOBAL_PER_DAY=2000   # everyone combined: a ceiling on spend
# AGENT_TIME_ZONE=America/Los_Angeles   # what "today" means for relative dates
