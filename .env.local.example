# Copy this file to .env.local (local dev) or set these in Vercel → Settings → Environment Variables.
# NEVER prefix a secret with VITE_: Vite inlines VITE_* variables into the public browser bundle.

# ── Server-only secrets ──────────────────────────────────────────────────────
# Anthropic API key (https://console.anthropic.com/). Used only by /api/claude.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Supabase project URL and anon (public) key. The server uses them to verify the signed-in
# user's token before any AI call; without them, /api/claude refuses every request.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Browser-visible (public by design) ───────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Optional tuning for /api/claude (defaults shown) ─────────────────────────
# ANTHROPIC_MODEL=claude-sonnet-4-6
# AI_MAX_OUTPUT_TOKENS=2048        # hard ceiling 16000
# AI_RATE_LIMIT_PER_MIN=20         # per user, per server instance
# AI_RATE_LIMIT_PER_DAY=400        # per user, per server instance
# AI_MAX_INPUT_CHARS=200000        # text characters per request
# AI_MAX_ATTACHMENTS=4
# ALLOWED_ORIGINS=                 # comma-separated; leave empty for same-origin only
